#include <iostream>
#include <vector>
using namespace std;

class Stack {
    vector<int> data;

public:
    void push(int x) {
        data.push_back(x);
        cout << x << " pushed\n";
    }

    int pop() {
        if (data.empty()) {
            cout << "Stack Underflow\n";
            return -1;
        }
        int val = data.back();
        data.pop_back();
        return val;
    }

    int peek() {
        if (data.empty()) {
            cout << "Stack is empty\n";
            return -1;
        }
        return data.back();
    }

    bool isEmpty() {
        return data.empty();
    }
};

int main() {
    Stack s;
    s.push(5);
    s.push(15);
    cout << "Top element: " << s.peek() << "\n";
    cout << "Popped: " << s.pop() << "\n";
    return 0;
}   